<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navi_bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ajustes"
            android:textColor="@color/navi_text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView style="@style/Hint" android:text="Tudo é salvo sozinho quando você sai desta tela." />

        <!-- ================= Cérebro ================= -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/CardTitle" android:text="🧠  Cérebro (Gemini)" />
            <TextView style="@style/Hint"
                android:text="Crie uma chave grátis no Google AI Studio e cole aqui. No plano grátis o Google pode usar as conversas para melhorar os produtos dele." />
            <Button android:id="@+id/btnGetKey" style="@style/BtnSecondary" android:text="Pegar chave grátis (AI Studio)" />
            <EditText android:id="@+id/geminiKey" style="@style/Field"
                android:hint="Chave da Gemini API" android:inputType="textPassword" />
            <EditText android:id="@+id/geminiModel" style="@style/Field"
                android:hint="Modelo (padrão: gemini-flash-latest)" android:inputType="text" />
            <EditText android:id="@+id/userName" style="@style/Field"
                android:hint="Seu nome" android:inputType="textPersonName" />
            <Switch android:id="@+id/followUp" style="@style/SwitchRow"
                android:text="Conversa contínua: depois de responder, continua ouvindo sem precisar dizer &quot;Navi&quot; de novo (ignora conversas que não são com ela)" />
            <Switch android:id="@+id/confirm" style="@style/SwitchRow"
                android:text="Perguntar antes de mandar mensagens, ligar ou fechar programas" />
            <Button android:id="@+id/btnTestBrain" style="@style/BtnPrimary" android:text="Testar o cérebro" />
        </LinearLayout>

        <!-- ================= Cérebros reserva ================= -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/CardTitle" android:text="🔁  Cérebros reserva (troca automática)" />
            <TextView style="@style/Hint"
                android:text="Quando o Gemini chega no limite grátis ou cai, a Navi passa sozinha para estes, sem perder a conversa, e volta para o Gemini quando ele liberar. Todos têm chave grátis." />
            <Button android:id="@+id/btnGroqKey" style="@style/BtnSecondary" android:text="Pegar chave grátis do Groq" />
            <EditText android:id="@+id/groqKey" style="@style/Field"
                android:hint="Chave do Groq (começa com gsk_)" android:inputType="textPassword" />
            <TextView style="@style/Hint" android:layout_marginTop="12dp" android:text="Terceiro cérebro" />
            <RadioGroup android:id="@+id/thirdProvider" android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <Button android:id="@+id/btnThirdKey" style="@style/BtnSecondary" android:text="Pegar chave grátis" />
            <EditText android:id="@+id/thirdKey" style="@style/Field"
                android:hint="Chave do terceiro cérebro" android:inputType="textPassword" />
            <EditText android:id="@+id/thirdModel" style="@style/Field"
                android:hint="Modelo (vazio = padrão)" android:inputType="text" />
            <TextView android:id="@+id/brainsInfo" style="@style/Hint" />
            <Button android:id="@+id/btnTestBrains" style="@style/BtnPrimary" android:text="Testar todos os cérebros" />
        </LinearLayout>

        <!-- ================= Privacidade ================= -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/CardTitle" android:text="🔒  Privacidade e acesso" />
            <TextView style="@style/Hint"
                android:text="Desligue o que a Navi não pode usar. Desligado, ela não lê, não guarda e não mexe naquele app." />
            <Switch android:id="@+id/lockProtect" style="@style/SwitchRow"
                android:text="Com o celular bloqueado, não ler mensagens, e-mails nem mexer no PC" />
            <LinearLayout
                android:id="@+id/accessList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- ================= TV ================= -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/CardTitle" android:text="📺  TV Samsung" />
            <TextView style="@style/Hint"
                android:text="Com a TV ligada e no mesmo Wi-Fi, toque em Procurar. Na 1ª vez, aceite o pedido que aparece na tela da TV." />
            <EditText android:id="@+id/tvIp" style="@style/Field"
                android:hint="IP da TV (ex.: 192.168.0.20)" android:inputType="text" />
            <LinearLayout style="@style/Row">
                <Button android:id="@+id/btnFindTv" style="@style/RowBtn" android:text="Procurar TV" />
                <Button android:id="@+id/btnTestTv" style="@style/RowBtn" android:text="Testar" />
            </LinearLayout>
            <TextView style="@style/Hint" android:layout_marginTop="10dp"
                android:text="Segunda via (SmartThings): se a TV não responder pela rede de casa, a Navi usa a nuvem da Samsung. Crie um token com todas as permissões de dispositivos e cole aqui." />
            <Button android:id="@+id/btnStToken" style="@style/BtnSecondary" android:text="Criar token da SmartThings" />
            <EditText android:id="@+id/stToken" style="@style/Field"
                android:hint="Token da SmartThings" android:inputType="textPassword" />
            <Button android:id="@+id/btnTestSt" style="@style/BtnSecondary" android:text="Testar SmartThings" />
            <TextView android:id="@+id/tvInfo" style="@style/Hint" />
        </LinearLayout>

        <!-- ================= PC ================= -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/CardTitle" android:text="💻  PC Windows" />
            <TextView style="@style/Hint"
                android:text="Abra o NaviPC.exe no computador. Clique no ícone ✦ perto do relógio > 'Parear um celular' e digite aqui o código de 8 dígitos." />
            <EditText android:id="@+id/pcHost" style="@style/Field"
                android:hint="Endereço do PC (ex.: 192.168.0.15:8765)" android:inputType="text" />
            <EditText android:id="@+id/pcCode" style="@style/Field"
                android:hint="Código de pareamento (8 dígitos)" android:inputType="number" android:maxLength="9" />
            <LinearLayout style="@style/Row">
                <Button android:id="@+id/btnFindPc" style="@style/RowBtn" android:text="Procurar PC" />
                <Button android:id="@+id/btnPairPc" style="@style/RowBtn" android:text="Parear" />
            </LinearLayout>
            <TextView android:id="@+id/pcInfo" style="@style/Hint" />
            <LinearLayout style="@style/Row">
                <Button android:id="@+id/btnRefreshPc" style="@style/RowBtn" android:text="Testar o PC" />
                <Button android:id="@+id/btnUnpairPc" style="@style/RowBtn" android:text="Desparear" />
            </LinearLayout>
        </LinearLayout>

        <!-- ================= Gmail ================= -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/CardTitle" android:text="✉️  Gmail" />
            <TextView style="@style/Hint"
                android:text="Use uma senha de app (precisa da verificação em duas etapas ligada). Não é a sua senha normal." />
            <Button android:id="@+id/btnAppPassword" style="@style/BtnSecondary" android:text="Criar senha de app do Google" />
            <EditText android:id="@+id/email" style="@style/Field"
                android:hint="seuemail@gmail.com" android:inputType="textEmailAddress" />
            <EditText android:id="@+id/emailPass" style="@style/Field"
                android:hint="Senha de app (16 letras)" android:inputType="textPassword" />
            <Button android:id="@+id/btnTestEmail" style="@style/BtnSecondary" android:text="Testar Gmail" />
        </LinearLayout>

        <!-- ================= Música ================= -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/CardTitle" android:text="🎵  Música no celular" />
            <TextView style="@style/Hint"
                android:text="App usado quando você diz &quot;Navi, toca...&quot; sem dizer onde. Para a Navi confirmar e controlar a música, libere o acesso às notificações." />
            <RadioGroup android:id="@+id/musicApps" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- ================= Sons e ativação ================= -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/CardTitle" android:text="🔔  Sons e ativação" />
            <TextView style="@style/Hint" android:text="Sensibilidade ao nome &quot;Navi&quot;. Pode falar o pedido junto: &quot;Navi, liga a TV&quot;. Se ela ativar sozinha, use Baixa; se não te ouvir, use Alta." />
            <RadioGroup android:id="@+id/wakeSens" android:layout_width="match_parent" android:layout_height="wrap_content">
                <RadioButton android:id="@+id/sensLow" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Baixa" android:textColor="@color/navi_text" />
                <RadioButton android:id="@+id/sensNormal" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Normal (recomendado)" android:textColor="@color/navi_text" />
                <RadioButton android:id="@+id/sensHigh" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Alta (responde mais rápido, ativa mais sem querer)" android:textColor="@color/navi_text" />
            </RadioGroup>
            <TextView style="@style/Hint" android:layout_marginTop="12dp" android:text="Volume dos sons" />
            <RadioGroup android:id="@+id/soundVolume" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="horizontal" />
            <TextView style="@style/Hint" android:layout_marginTop="12dp" android:text="Som quando a Navi começa a ouvir" />
            <RadioGroup android:id="@+id/startSound" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <Button android:id="@+id/btnPlayStart" style="@style/BtnSecondary" android:text="Ouvir som de início" />
            <TextView style="@style/Hint" android:layout_marginTop="12dp" android:text="Som quando a Navi para de ouvir" />
            <RadioGroup android:id="@+id/endSound" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <Button android:id="@+id/btnPlayEnd" style="@style/BtnSecondary" android:text="Ouvir som de encerramento" />
        </LinearLayout>

        <!-- ================= Permissões ================= -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/CardTitle" android:text="✅  Permissões do celular" />
            <TextView android:id="@+id/perms" style="@style/Hint" android:lineSpacingExtra="6dp" android:textSize="14sp" />
            <Button android:id="@+id/btnMic" style="@style/BtnSecondary" android:text="Microfone, notificações, contatos e ligações" />
            <Button android:id="@+id/btnNotifAccess" style="@style/BtnSecondary" android:text="Acesso às notificações (ler mensagens)" />
            <Button android:id="@+id/btnAccessibility" style="@style/BtnSecondary" android:text="Acessibilidade (WhatsApp, travar tela, print)" />
            <LinearLayout style="@style/Row">
                <Button android:id="@+id/btnWriteSettings" style="@style/RowBtn" android:text="Brilho do celular" />
                <Button android:id="@+id/btnDnd" style="@style/RowBtn" android:text="Não perturbe" />
            </LinearLayout>
            <TextView style="@style/Hint"
                android:text="Se o Android disser que é uma configuração restrita: Configurações > Apps > Navi > ⋮ > Permitir configurações restritas." />
            <Button android:id="@+id/btnOverlay" style="@style/BtnSecondary" android:text="Sobrepor outros apps" />
            <Button android:id="@+id/btnBattery" style="@style/BtnSecondary" android:text="Tirar da economia de bateria" />
            <LinearLayout style="@style/Row">
                <Button android:id="@+id/btnXiaomi" style="@style/RowBtn" android:text="Xiaomi: pop-up" />
                <Button android:id="@+id/btnAutostart" style="@style/RowBtn" android:text="Xiaomi: autoinício" />
            </LinearLayout>
        </LinearLayout>

        <!-- ================= Palavra de ativação ================= -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/CardTitle" android:text="🎙️  Palavra de ativação" />
            <EditText android:id="@+id/words" style="@style/Field"
                android:hint="Palavras que ativam (separadas por vírgula)" android:inputType="text" />
            <Switch android:id="@+id/vibrate" style="@style/SwitchRow" android:text="Vibrar quando ouvir &quot;Navi&quot;" />
            <Switch android:id="@+id/ownBrain" style="@style/SwitchRow"
                android:text="A própria Navi responde (desligado = só abre o Gemini, como antes)" />
            <TextView style="@style/Hint" android:text="Se ela só abrir o Gemini, como abrir:" />
            <RadioGroup android:id="@+id/mode" android:layout_width="match_parent" android:layout_height="wrap_content">
                <RadioButton android:id="@+id/modeVoice" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Assistente padrão" android:textColor="@color/navi_text" />
                <RadioButton android:id="@+id/modeAssist" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Gesto de assistente" android:textColor="@color/navi_text" />
                <RadioButton android:id="@+id/modeGemini" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Abrir o app do Gemini" android:textColor="@color/navi_text" />
            </RadioGroup>
            <EditText android:id="@+id/pause" style="@style/Field"
                android:hint="Segundos de pausa depois de abrir o Gemini" android:inputType="number" />
        </LinearLayout>

        <!-- ================= Memória ================= -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/CardTitle" android:text="🧩  O que a Navi lembra" />
            <TextView android:id="@+id/memories" style="@style/Hint" android:textSize="14sp" />
            <LinearLayout style="@style/Row">
                <Button android:id="@+id/btnClearMem" style="@style/RowBtn" android:text="Apagar memórias" />
                <Button android:id="@+id/btnClearChat" style="@style/RowBtn" android:text="Limpar conversa" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
